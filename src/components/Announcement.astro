---
export interface Props {
  variant?: 'card' | 'banner';
}

const { variant = 'card' } = Astro.props;

const title = 'The Concert on Lake Grapevine';
const date = 'Sunday, October 11 \u00b7 12\u20139 PM';
const description =
  'Four tribute bands, BYOB, food trucks, and great views at Mariner Park Point \u2014 all for charity. Presented by Tolbert\u2019s.';
const cta = 'Event details & tickets';
const href = '/posts/concert-on-the-lake-grapevine-2026';
---

<section aria-label="Announcement">
  {
    variant === 'banner' ? (
      <div class="bg-gradient-to-r from-primary to-primary/90 px-4 py-3">
        <div class="mx-auto max-w-7xl text-center">
          <p class="text-lg font-bold text-white">
            {title} &mdash; {date}
          </p>
          <p class="text-sm text-white/90">
            {description}
          </p>
          <a
            href={href}
            class="mt-3 inline-block rounded-full bg-white px-5 py-2 text-sm font-semibold text-primary shadow-sm transition-colors hover:bg-stone-100"
          >
            {cta}
          </a>
        </div>
      </div>
    ) : (
      <div class="relative bg-gradient-to-r from-primary to-primary/90 px-4 py-6">
        <div class="relative mx-auto max-w-5xl">
          <div class="rounded-lg border-0 bg-white/95 backdrop-blur-sm shadow-sm">
            <div class="p-6">
              <div class="flex flex-col items-center space-y-4 text-center">
                <div class="space-y-2">
                  <h2 class="text-3xl font-bold text-foreground lg:text-4xl">
                    {title}
                  </h2>
                  <p class="text-lg font-semibold text-primary">
                    {date}
                  </p>
                  <p class="max-w-2xl text-muted-foreground">
                    {description}
                  </p>
                </div>

                <a
                  href={href}
                  aria-label={`${cta} - ${title}`}
                  class="inline-flex items-center gap-2 rounded-full bg-muted px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-stone-200"
                >
                  {cta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>
