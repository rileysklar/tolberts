---
export interface Props {
  variant?: "card" | "banner";
}

const { variant = "card" } = Astro.props;

const title = "The Concert on Lake Grapevine";
const date = "Sunday, October 11 \u00b7 12\u20139 PM";
const description =
  "Four tribute bands, BYOB, food trucks, and great views at Mariner Park Point \u2014 all for charity. Presented by Tolbert\u2019s.";
const cta = "Event details & tickets";
const href = "/posts/concert-on-the-lake-grapevine-2026";
---

<section aria-label="Announcement">
  {
    variant === "banner" ? (
      <div class="bg-gradient-to-r from-primary to-primary/90 py-3">
        <div class="site-container text-center">
          <p class="text-base font-bold text-white sm:text-lg">
            {title} &mdash; {date}
          </p>
          <p class="text-sm text-white/90">{description}</p>
          <a
            href={href}
            class="site-button site-button-size-default site-button-light mt-3"
          >
            {cta}
          </a>
        </div>
      </div>
    ) : (
      <div class="relative bg-gradient-to-r from-primary to-primary/90 px-4 py-5 sm:py-6">
        <div class="relative mx-auto max-w-5xl">
          <div class="site-surface border-white/70 bg-white/95 backdrop-blur-sm">
            <div class="p-5 sm:p-6">
              <div class="flex flex-col items-center space-y-3 text-center">
                <div class="space-y-2">
                  <h2 class="text-2xl font-bold text-foreground sm:text-3xl lg:text-4xl">
                    {title}
                  </h2>
                  <p class="text-base font-semibold text-primary sm:text-lg">
                    {date}
                  </p>
                  <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
                    {description}
                  </p>
                </div>

                <a
                  href={href}
                  aria-label={`${cta} - ${title}`}
                  class="site-button site-button-size-default site-button-primary"
                >
                  {cta}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>
