---
export const prerender = false;

import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { isResourceAvailable } from "@/lib/remote";

// Define the brunch menu URL
const defaultBrunchMenuUrl =
  "https://tolbertscms.com/wp-content/uploads/2024/04/Brunch-Menu-Current-April-2023.pdf";

// Override at deploy time when the CMS moves, without touching code.
const brunchMenuUrl =
  (typeof process !== "undefined"
    ? process.env.BRUNCH_MENU_PDF_URL
    : undefined) ||
  import.meta.env.BRUNCH_MENU_PDF_URL ||
  defaultBrunchMenuUrl;

// Bundled copy used whenever the CMS-hosted menu cannot be reached.
const localBrunchMenuUrl = "/tolberts-brunch-menu.pdf";

// Perform the resource check directly on the brunch menu URL
const isAvailable = await isResourceAvailable(brunchMenuUrl);

// Redirect to the brunch menu if available
if (isAvailable) {
  return Astro.redirect(brunchMenuUrl);
} else {
  console.warn(
    `[brunch-menu] ${brunchMenuUrl} is unavailable; redirecting to ${localBrunchMenuUrl}`,
  );
  return Astro.redirect(localBrunchMenuUrl);
}
---

<Layout
  metaTags={{
    title: "Brunch Menu | Tolbert's Restaurant",
    description:
      "View our brunch menu at Tolbert's Restaurant & Chili Parlor in Grapevine, TX.",
    noindex: true,
  }}
>
  <div
    class="h-screen-minus-55 flex items-center justify-center p-6 text-center shadow-md"
  >
    <div class="max-w-md">
      <h1 class="mb-4 text-3xl font-bold">Brunch Menu Unavailable</h1>
      <p class="mb-6">
        Oh no! The brunch menu seems to be enjoying brunch somewhere else right
        now.
        <br /> But don't worry, you can still head back home and explore our other
        options!
      </p>
      <a href="/">
        <Button> Take Me Home </Button>
      </a>
    </div>
  </div>
</Layout>
