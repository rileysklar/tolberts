---
export const prerender = false;

import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { isResourceAvailable } from "@/lib/remote";

const defaultMenuUrl =
  "https://tolbertscms.com/wp-content/uploads/2026/09/TolbertsNewMenu081926.pdf";

// Override at deploy time when the CMS moves, without touching code.
const menuUrl =
  (typeof process !== "undefined" ? process.env.MENU_PDF_URL : undefined) ||
  import.meta.env.MENU_PDF_URL ||
  defaultMenuUrl;

// Bundled copy used whenever the CMS-hosted menu cannot be reached. Refresh it
// from the current PDF whenever the menu changes.
const localMenuUrl = "/tolberts-menu.pdf";

const isAvailable = await isResourceAvailable(menuUrl);

if (isAvailable) {
  return Astro.redirect(menuUrl);
} else {
  console.warn(
    `[menu] ${menuUrl} is unavailable; redirecting to ${localMenuUrl}`,
  );
  return Astro.redirect(localMenuUrl);
}
---

<Layout
  metaTags={{
    title: "Menu | Tolbert's Restaurant",
    description:
      "View our full menu at Tolbert's Restaurant & Chili Parlor in Grapevine, TX.",
    noindex: true,
  }}
>
  <div
    class="flex h-screen-minus-55 items-center justify-center p-6 text-center shadow-md"
  >
    <div class="max-w-md">
      <h1 class="mb-4 text-3xl font-bold">Menu Changes Incoming</h1>

      <p class="mb-6">
        It looks like the menu decided to play hide and seek. Unfortunately,
        it's not available right now.
        <br /> Don't worry, we'll help you get back on track!
      </p>
      <a href="/">
        <Button> Take Me Home </Button>
      </a>
    </div>
  </div>
</Layout>
