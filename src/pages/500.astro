---
import Layout from "../layouts/Layout.astro";
---

<Layout
  metaTags={{
    title: "Something Went Wrong | Tolbert's Restaurant",
    description:
      "We hit an unexpected error. Please try again, or head back to the homepage.",
    noindex: true,
  }}
>
  <main
    class="site-container site-section flex min-h-[60vh] flex-col items-center justify-center gap-6 text-center"
  >
    <div class="max-w-xl">
      <h1 class="noto text-3xl font-bold sm:text-4xl lg:text-5xl">
        Well, that's a spicy meatball.
      </h1>
      <p class="mt-4 text-base leading-relaxed text-stone-700 sm:text-lg">
        Something went wrong on our end. The restaurant is still open — please
        try again in a moment, or head back home.
      </p>
    </div>
    <div class="flex flex-col items-center gap-3 sm:flex-row">
      <a
        href="/"
        class="site-button site-button-size-default site-button-primary"
      >
        Back to Home
      </a>
      <a
        href="/calendar/"
        class="site-button site-button-size-default border border-stone-300 bg-white text-stone-900 hover:bg-stone-100"
      >
        Check the Calendar
      </a>
    </div>
    <p class="text-sm text-stone-600">
      Need us right away? Call{" "}
      <a class="underline" href="tel:+18174214888">(817) 421-4888</a>.
    </p>
  </main>
</Layout>
